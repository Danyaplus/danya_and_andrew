PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Supabase Project URL, for example https://xxxx.supabase.co
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Server-only key from Supabase Project Settings / API Keys.
# Prefer the new sb_secret_... key. NEVER put this key in frontend code.
SUPABASE_SECRET_KEY=sb_secret_YOUR_SECRET_KEY

# Admin panel: set these as PRIVATE environment variables on the backend (Render).
# Never prefix them with VITE_ or commit real values to GitHub.
# The admin login page remains unavailable until both are configured.
ADMIN_USERNAME=YOUR_PRIVATE_ADMIN_LOGIN
ADMIN_PASSWORD=YOUR_RANDOM_PASSWORD_AT_LEAST_20_CHARACTERS

# Optional server-side automatic translation for global announcements.
# Configure ONE provider; without one, publishing an announcement is disabled.
# Provider A: Google Cloud Translation API v2 (requires enabled API + billing).
# GOOGLE_TRANSLATE_API_KEY=YOUR_TRANSLATION_API_KEY
# Provider B: your HTTPS LibreTranslate service (self-hosted or provider).
# LIBRETRANSLATE_URL=https://translate.yourdomain.example
# LIBRETRANSLATE_API_KEY=YOUR_LIBRETRANSLATE_API_KEY_IF_REQUIRED
