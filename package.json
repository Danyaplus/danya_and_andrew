{
  "name": "kodumi-games",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n FRONTEND,BACKEND -c auto \"npm run dev -w frontend\" \"npm run dev -w backend\"",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
